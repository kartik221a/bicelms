# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# SESSION_SECRET="generate-a-long-random-string"   # required in production

# ── Firebase Authentication + Firestore (production data provider) ──────────
# Without these the app runs in setup mode on the local SQLite provider.
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="project"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="project.appspot.com"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxx"

# ── Cloudinary storage (signed direct uploads + protected video) ────────────
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Razorpay payments (INR) ──────────────────────────────────────────────────
# RAZORPAY_KEY_ID="rzp_live_..."        # or rzp_test_...
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""            # from the Razorpay webhook settings

# ── Email (optional; console provider used until configured) ────────────────
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="BICE Academy <no-reply@your-domain.com>"
